{
  "name": "henniefrancis-tech-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Repository tooling for henniefrancis.tech (test harness and local preview). The site itself lives in src/.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test:e2e": "playwright test --grep-invert \"@visual|@capture\"",
    "test:visual": "playwright test --grep @visual",
    "baseline": "playwright test --grep @capture",
    "preview": "node tools/preview/src/cli.mjs --dir src/dist/henniefrancis-tech/browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
