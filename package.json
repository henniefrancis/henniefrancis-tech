{
  "name": "henniefrancis-tech",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content:generate": "node tools/content/generate.mjs",
    "content:fixtures": "node tools/content/generate.mjs --src tools/content/fixtures/tree",
    "content:validate": "node tools/content/validate.mjs",
    "content:compare": "node tools/content/compare-dom.mjs",
    "content:test": "npm test --prefix tools/content",
    "prestart": "npm run content:generate",
    "start": "ng serve",
    "prebuild": "npm run content:generate",
    "build": "ng build",
    "prewatch": "npm run content:generate",
    "postbuild": "node tools/seo/cli.mjs dist/henniefrancis-tech/browser && node tools/csp/cli.mjs dist/henniefrancis-tech/browser",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run content:fixtures",
    "test": "ng test",
    "pretest:ci": "npm run content:fixtures",
    "test:ci": "ng test --no-watch",
    "test:e2e": "playwright test --grep-invert \"@visual|@capture\"",
    "test:visual": "playwright test --grep @visual",
    "baseline": "playwright test --grep @capture",
    "preview": "node tools/preview/src/cli.mjs --dir dist/henniefrancis-tech/browser"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.6",
    "@fontsource/dongle": "5.3.0",
    "bootstrap": "5.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "description": "Personal site of Hennie Francis: an Angular application prerendered to static HTML."
}
