{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henniefrancis.tech/schemas/page-home.schema.json",
  "title": "home.yaml",
  "allOf": [
    {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PageMeta"
    }
  ],
  "type": "object",
  "required": [
    "description",
    "heading",
    "name",
    "profile",
    "tagline",
    "about",
    "tiles"
  ],
  "properties": {
    "title": true,
    "description": true,
    "heading": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
    },
    "name": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
    },
    "profile": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ImageField"
    },
    "tagline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PlainText"
      }
    },
    "about": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/Paragraphs"
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "route",
          "image"
        ],
        "properties": {
          "name": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
          },
          "route": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/InternalPath"
          },
          "image": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ImageField"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
