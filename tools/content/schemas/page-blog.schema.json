{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henniefrancis.tech/schemas/page-blog.schema.json",
  "title": "blog.yaml",
  "allOf": [
    {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PageHead"
    }
  ],
  "type": "object",
  "required": [
    "intro",
    "links"
  ],
  "properties": {
    "title": true,
    "description": true,
    "heading": true,
    "breadcrumb": true,
    "intro": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PlainText"
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/LinkedImage"
      }
    }
  },
  "unevaluatedProperties": false
}
