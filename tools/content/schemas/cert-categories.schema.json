{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henniefrancis.tech/schemas/cert-categories.schema.json",
  "title": "categories.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categories"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/Slug"
            }
          }
        }
      }
    }
  }
}
