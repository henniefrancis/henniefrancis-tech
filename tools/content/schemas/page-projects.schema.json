{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henniefrancis.tech/schemas/page-projects.schema.json",
  "title": "projects.yaml",
  "allOf": [
    {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PageHead"
    }
  ],
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "title": true,
    "description": true,
    "heading": true,
    "breadcrumb": true,
    "projects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
          },
          "badge": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
          },
          "description": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/Paragraphs"
          },
          "diagram": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ImageField"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
