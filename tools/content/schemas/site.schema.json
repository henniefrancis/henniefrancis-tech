  "$id": "https://henniefrancis.tech/schemas/site.schema.json",
  "title": "site.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "copyright"
  ],
  "properties": {
    "name": {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
    },
    "copyright": {
