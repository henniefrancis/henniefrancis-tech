{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henniefrancis.tech/schemas/page-career-history.schema.json",
  "title": "career-history.yaml",
  "allOf": [
    {
      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/PageHead"
    }
  ],
  "type": "object",
  "required": [
    "employers",
    "labels"
  ],
  "properties": {
    "title": true,
    "description": true,
    "heading": true,
    "breadcrumb": true,
    "employers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "names",
          "location",
          "positions"
        ],
        "properties": {
          "id": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/Slug"
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
            }
          },
          "location": {
            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
          },
          "positions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "titles",
                "period",
                "columns",
                "responsibilities",
                "reason"
              ],
              "properties": {
                "titles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
                  }
                },
                "period": {
                  "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
                },
                "columns": {
                  "enum": [
                    "wide",
                    "medium",
                    "narrow"
                  ]
                },
                "responsibilities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/LongText"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "group",
                          "items"
                        ],
                        "properties": {
                          "group": {
                            "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
                          },
                          "items": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 30,
                            "items": {
                              "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/LongText"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "reason": {
                  "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/TextOrEmpty"
                },
                "referee": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "phone",
                    "email"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText",
                      "x-personal-data": true
                    },
                    "phone": {
                      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText",
                      "x-personal-data": true
                    },
                    "email": {
                      "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/Email",
                      "x-personal-data": true
                    }
                  }
                },
                "reasonLabel": {
                  "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionDetails",
        "responsibilities",
        "reason",
        "references"
      ],
      "properties": {
        "positionDetails": {
          "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
        },
        "responsibilities": {
          "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
        },
        "reason": {
          "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
        },
        "references": {
          "$ref": "https://henniefrancis.tech/schemas/defs.schema.json#/$defs/ShortText"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
